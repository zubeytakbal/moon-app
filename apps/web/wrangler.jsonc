{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Lunatlas: Next.js sitesi, OpenNext ile Cloudflare Workers üzerinde (https://opennext.js.org/cloudflare)
	"main": ".open-next/worker.js",
	"name": "lunatlas",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Kendine başvuru; ad, Worker adıyla aynı olmalı
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lunatlas"
		}
	],
	"r2_buckets": [
		{
			// Sayfa önbelleği ("use cache", saatlik yenilenen "bugün" sayfaları)
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "lunatlas-opennext-cache"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				// Süresi dolan sayfaları arka planda yeniden üreten kuyruk
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
	"observability": {
		"enabled": true
	}
}
